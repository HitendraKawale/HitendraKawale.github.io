---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import Brand from "../../components/Brand.astro";
import { getCollection } from "astro:content";
import { profile } from "../../data/profile";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year — the volume's parts
const years = [...new Set(posts.map(p => new Date(p.data.date).getFullYear()))]
  .sort((a, b) => b - a);
---

<BaseLayout
  title={`The Chronicles — ${profile.name}`}
  description="Writing on AI engineering, RAG systems, LLM evaluation, learning languages, and the long struggle of building things that work."
>
  <header class="masthead">
    <div class="wrap">
      <div class="chapter-cap" data-reveal="rise">
        <Brand size={13} />
        <span class="label label-blood">Chapter III</span>
        <span class="rule"></span>
        <span class="label label-ash">{posts.length} entries</span>
      </div>

      <h1 class="mast-title">
        <span class="mast-line" data-reveal="wipe"><span class="mast-in">The</span></span>
        <span class="mast-line" data-reveal="wipe" style="--d:120ms"><span class="mast-in">Chronicles</span></span>
      </h1>

      <p class="mast-lede" data-reveal="rise" style="--d:260ms">
        Dispatches from the road — AI engineering, systems that broke and why,
        eight languages, and the parts of the degree nobody puts on a CV.
      </p>
    </div>
  </header>

  <section class="archive">
    <div class="wrap">
      {posts.length === 0 ? (
        <div class="empty">
          <div class="empty-cap tone"></div>
          <div class="empty-body">
            <span class="hatch" aria-hidden="true"></span>
            <p class="empty-title">No tales yet told</p>
            <p class="empty-note">The first chapter is still being written. Return soon.</p>
          </div>
        </div>
      ) : years.map(year => (
        <div class="year-block">
          <div class="year-head">
            <span class="year-num">{year}</span>
            <span class="rule"></span>
            <span class="year-count">
              {posts.filter(p => new Date(p.data.date).getFullYear() === year).length} entries
            </span>
          </div>

          <div class="year-list">
            {posts
              .filter(p => new Date(p.data.date).getFullYear() === year)
              .map((post, i) => <BlogCard post={post} index={i} />)}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .masthead {
    padding-block: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .chapter-cap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: clamp(28px, 5vw, 52px);
  }

  .chapter-cap .label { white-space: nowrap; }

  .mast-title {
    font-family: var(--display);
    font-weight: 900;
    font-size: var(--t-xxl);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .mast-line { display: block; overflow: hidden; padding-block: 0.05em; }

  .mast-in {
    display: block;
    background: linear-gradient(100deg, var(--bone) 52%, #d78a68 78%, var(--blood-hi) 100%);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .mast-lede {
    font-size: var(--t-md);
    line-height: 1.8;
    color: var(--ash);
    max-width: 50ch;
    margin-top: clamp(22px, 3vw, 34px);
  }

  .archive { padding-block: clamp(40px, 6vw, 76px) clamp(64px, 10vw, 120px); }

  .year-block + .year-block { margin-top: clamp(40px, 6vw, 72px); }

  .year-head {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 8px;
  }

  .year-num {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--brass-dim);
    font-variant-numeric: lining-nums;
  }

  .year-count {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ash-dim);
    white-space: nowrap;
  }

  .year-list { border-top: 1px solid var(--line); }

  /* ── Empty ────────────────────────── */
  .empty { border: 1px solid var(--line); }
  .empty-cap { height: 26px; }

  .empty-body {
    position: relative;
    padding: clamp(48px, 8vw, 88px) var(--gutter);
    text-align: center;
    background: var(--soot);
    color: var(--ash-dim);
  }

  .empty-title, .empty-note { position: relative; z-index: 1; }

  .empty-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--bone);
  }

  .empty-note { font-style: italic; color: var(--ash); margin-top: 12px; }
</style>
