---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import { profile } from "../data/profile";

const channels = [
  {
    key: "Email",
    value: profile.email,
    note: "Best for anything with detail",
    href: `mailto:${profile.email}`,
  },
  {
    key: "Resume",
    value: "Hitendra-Kawale.pdf",
    note: "One page, current",
    href: profile.resume,
    download: "Hitendra-Kawale-Resume.pdf",
  },
  {
    key: "GitHub",
    value: "@" + profile.github.split("/").pop(),
    note: "The source of everything in the armoury",
    href: profile.github,
    external: true,
  },
  ...(profile.linkedin ? [{
    key: "LinkedIn",
    value: profile.linkedin.replace(/^https?:\/\/(www\.)?/, ""),
    note: "For recruiters and introductions",
    href: profile.linkedin,
    external: true,
  }] : []),
];

// The work worth writing about
const takes = [
  {
    title: "AI & LLM systems",
    note: "RAG pipelines, agent workflows, evaluation harnesses, and serving that holds up under load.",
  },
  {
    title: "Backend & infrastructure",
    note: "FastAPI services, data pipelines, Docker and Kubernetes deployment, metrics and tracing.",
  },
  {
    title: "Vision & 3D",
    note: "Scene understanding, segmentation, and Gaussian splatting — the dissertation territory.",
  },
  {
    title: "Prototypes & audits",
    note: "A working proof of concept in weeks, or a hard look at an AI system that isn't behaving.",
  },
];
---

<BaseLayout
  title={`Send Word — ${profile.name}`}
  description="Get in touch with Hitendra Kawale — AI engineer, open to roles and collaborations."
>
  <header class="masthead">
    <div class="wrap">
      <div class="chapter-cap" data-reveal="rise">
        <Brand size={13} />
        <span class="label label-blood">Causality</span>
        <span class="rule"></span>
        <span class="label label-ash">UK — GMT/BST</span>
      </div>

      <div class="mast-grid">
        <div class="mast-left">
          <h1 class="mast-title">
            <span class="mast-line" data-reveal="wipe"><span class="mast-in">Send</span></span>
            <span class="mast-line" data-reveal="wipe" style="--d:120ms"><span class="mast-in">Word</span></span>
          </h1>

          <p class="mast-lede" data-reveal="rise" style="--d:260ms">
            Whether causality led you here or plain curiosity — I'm open to AI
            engineering roles, hard problems, and collaborations. I reply to
            everything, usually within a day.
          </p>

          <a href={`mailto:${profile.email}`} class="primary" data-reveal="rise" style="--d:360ms">
            <span>Write to me</span>
            <span class="primary-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <dl class="facts" data-reveal="rise" style="--d:200ms">
          <div class="fact">
            <dt>Status</dt>
            <dd class="fact-live">
              <span class="fact-dot"></span>{profile.availability}
            </dd>
          </div>
          <div class="fact">
            <dt>Freelance</dt>
            <dd>Taking projects</dd>
          </div>
          <div class="fact">
            <dt>Based</dt>
            <dd>United Kingdom</dd>
          </div>
          <div class="fact">
            <dt>Reply within</dt>
            <dd>One day</dd>
          </div>
          <div class="fact">
            <dt>Meetings in</dt>
            <dd>English · Spanish · Mandarin</dd>
          </div>
        </dl>
      </div>
    </div>
  </header>

  <section class="takes">
    <div class="wrap">
      <header class="chapter" data-reveal="rise">
        <span class="label label-brass">[ What I take on ]</span>
        <span class="rule"></span>
        <span class="chapter-link">Freelance &amp; contract</span>
      </header>

      <ul class="take-grid">
        {takes.map((t, i) => (
          <li class="take" data-reveal="rise" style={`--d:${i * 70}ms`}>
            <span class="take-title">{t.title}</span>
            <span class="take-note">{t.note}</span>
          </li>
        ))}
      </ul>

      <p class="take-shape" data-reveal="rise" style="--d:300ms">
        Short scoped builds or something ongoing — both work.
      </p>
    </div>
  </section>

  <section class="channels">
    <div class="wrap">
      <div class="ch-list">
        {channels.map((c, i) => (
          <a
            class="ch"
            href={c.href}
            target={"external" in c && c.external ? "_blank" : undefined}
            rel={"external" in c && c.external ? "noreferrer" : undefined}
            download={"download" in c ? c.download : undefined}
            data-reveal="rise"
            style={`--d:${i * 80}ms`}
          >
            <span class="ch-key">{c.key}</span>
            <span class="ch-main">
              <span class="ch-value">{c.value}</span>
              <span class="ch-note">{c.note}</span>
            </span>
            <span class="ch-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <p class="ch-foot" data-reveal="rise">
        Freelance and contract work welcome alongside full-time roles. Whether
        you're hiring or have one problem that needs solving, lead with the
        problem — it's the fastest way to a real answer.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead {
    padding-block: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .chapter-cap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: clamp(28px, 5vw, 52px);
  }

  .chapter-cap .label { white-space: nowrap; }

  .mast-title {
    font-family: var(--display);
    font-weight: 900;
    font-size: var(--t-xxl);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .mast-line { display: block; overflow: hidden; padding-block: 0.05em; }

  .mast-in {
    display: block;
    background: linear-gradient(100deg, var(--bone) 52%, #d78a68 78%, var(--blood-hi) 100%);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .mast-lede {
    font-size: var(--t-md);
    line-height: 1.8;
    color: var(--ash);
    max-width: 52ch;
    margin-top: clamp(22px, 3vw, 34px);
  }

  .primary {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
    padding: 14px 26px;
    border: 1px solid var(--blood);
    background: rgba(147, 23, 27, 0.1);
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone);
    transition: background-color 260ms, border-color 260ms, color 260ms;
  }

  .primary:hover {
    background: var(--blood);
    border-color: var(--blood-hi);
    color: #fff;
  }

  .primary-arrow { transition: transform 320ms var(--ease); }
  .primary:hover .primary-arrow { transform: translateX(6px); }

  /* ── Masthead grid + facts ────────── */
  .mast-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  .facts {
    border-top: 1px solid var(--line);
    padding-top: 4px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .fact dt {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ash-dim);
  }

  .fact dd {
    font-size: var(--t-sm);
    color: var(--bone);
    line-height: 1.5;
  }

  .fact-live {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--green);
  }

  .fact-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
    animation: factPulse 2.6s ease-in-out infinite;
  }

  @keyframes factPulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.28; }
  }

  @media (max-width: 820px) {
    .mast-grid { grid-template-columns: 1fr; }
  }

  /* ── What I take on ───────────────── */
  .takes {
    padding-block: clamp(44px, 7vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .take-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .take {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2.6vw, 28px);
    background: var(--void);
    transition: background-color 300ms var(--ease);
  }

  .take:hover { background: var(--soot); }

  .take-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--bone);
  }

  .take-note {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--ash);
  }

  .take-shape {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--brass);
    margin-top: 22px;
  }

  @media (max-width: 700px) {
    .take-grid { grid-template-columns: 1fr; }
  }

  /* ── Channels ─────────────────────── */
  .channels { padding-block: clamp(44px, 7vw, 84px) clamp(64px, 10vw, 120px); }

  .ch-list { border-top: 1px solid var(--line); }

  .ch {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    align-items: center;
    gap: clamp(14px, 3vw, 32px);
    padding: clamp(20px, 3vw, 30px) 0;
    border-bottom: 1px solid var(--line);
    position: relative;
    isolation: isolate;
  }

  .ch::before {
    content: '';
    position: absolute;
    inset: 0 0 0 -100vw;
    z-index: -1;
    background: linear-gradient(90deg, transparent, rgba(147, 23, 27, 0.12) 80%, rgba(147, 23, 27, 0.24));
    opacity: 0;
    transition: opacity 380ms var(--ease);
  }

  .ch:hover::before { opacity: 1; }

  .ch-key {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--brass-dim);
    transition: color 260ms;
  }

  .ch:hover .ch-key { color: var(--brass); }

  .ch-value {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.6vw, 1.75rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    word-break: break-word;
    transition: color 260ms, transform 400ms var(--ease);
  }

  .ch:hover .ch-value { color: var(--blood-hi); transform: translateX(8px); }

  .ch-note {
    display: block;
    font-size: var(--t-sm);
    color: var(--ash);
    margin-top: 6px;
  }

  .ch-arrow {
    color: var(--ash-dim);
    transition: transform 320ms var(--ease), color 260ms;
  }

  .ch:hover .ch-arrow { color: var(--blood-hi); transform: translate(3px, -3px); }

  .ch-foot {
    font-size: var(--t-sm);
    line-height: 1.8;
    color: var(--ash-dim);
    max-width: 54ch;
    margin-top: clamp(30px, 4vw, 48px);
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }

  @media (max-width: 620px) {
    .ch { grid-template-columns: 1fr auto; }
    .ch-key { grid-column: 1 / -1; }
  }
</style>
