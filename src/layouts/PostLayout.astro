---
import BaseLayout from "./BaseLayout.astro";
import Brand from "../components/Brand.astro";

interface Adjacent {
  title: string;
  slug: string;
}

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    tags?: string[];
  };
  minutes?: number;
  prev?: Adjacent | null;
  next?: Adjacent | null;
}

const { frontmatter, minutes = 1, prev = null, next = null } = Astro.props;

const d = new Date(frontmatter.date);
const formatted = new Intl.DateTimeFormat("en-GB", {
  day: "numeric", month: "long", year: "numeric",
}).format(d);
---

<BaseLayout
  title={`${frontmatter.title} — Hitendra Kawale`}
  description={frontmatter.description}
>
  <article class="post">
    <header class="post-head wrap">
      <div class="chapter-cap">
        <Brand size={12} />
        <a href="/blog" class="back">Chronicles</a>
        <span class="rule"></span>
        <span class="label label-ash">{minutes} min read</span>
      </div>

      <h1 data-reveal="rise">{frontmatter.title}</h1>

      <p class="standfirst" data-reveal="rise" style="--d:120ms">{frontmatter.description}</p>

      <div class="post-meta" data-reveal="rise" style="--d:200ms">
        <time datetime={d.toISOString()}>{formatted}</time>
        {frontmatter.tags && frontmatter.tags.length > 0 && (
          <ul class="tags">
            {frontmatter.tags.map(t => <li>{t}</li>)}
          </ul>
        )}
      </div>
    </header>

    <div class="prose wrap">
      <slot />
    </div>

    <div class="wrap">
      <div class="post-end" aria-hidden="true">
        <span class="rule"></span>
        <Brand size={20} />
        <span class="rule"></span>
      </div>

      {(prev || next) && (
        <nav class="adjacent" aria-label="More entries">
          {prev ? (
            <a href={`/blog/${prev.slug}`} class="adj adj-prev">
              <span class="adj-label">← Previous</span>
              <span class="adj-title">{prev.title}</span>
            </a>
          ) : <span></span>}

          {next ? (
            <a href={`/blog/${next.slug}`} class="adj adj-next">
              <span class="adj-label">Next →</span>
              <span class="adj-title">{next.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding-block: clamp(40px, 6vw, 72px) clamp(64px, 10vw, 120px); }

  /* The post column sits narrower than the page measure */
  .post .wrap { max-width: 760px; }

  .chapter-cap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: clamp(28px, 5vw, 48px);
  }

  .back {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ash);
    white-space: nowrap;
    transition: color 200ms;
  }

  .back:hover { color: var(--blood-hi); }

  h1 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .standfirst {
    font-size: clamp(1.05rem, 1.9vw, 1.3rem);
    line-height: 1.7;
    color: var(--ash);
    font-style: italic;
    margin-top: 20px;
    max-width: 54ch;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .post-meta time {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    color: var(--brass);
  }

  .tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .tags li {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ash-dim);
    border: 1px solid var(--line);
    padding: 4px 9px;
  }

  /* ════ PROSE ══════════════════════════════════════════════ */
  .prose {
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--bone);
    padding-top: clamp(32px, 5vw, 48px);
  }

  /* Illuminated initial */
  .prose :global(> p:first-of-type::first-letter) {
    float: left;
    font-family: var(--display);
    font-weight: 900;
    font-size: 4.1em;
    line-height: 0.78;
    padding: 0.06em 0.1em 0 0;
    color: var(--blood-hi);
  }

  .prose :global(p) { margin-bottom: 26px; }

  .prose :global(h2) {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 56px 0 18px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .prose :global(h3) {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    margin: 36px 0 12px;
  }

  .prose :global(ul), .prose :global(ol) {
    padding-left: 22px;
    margin-bottom: 26px;
  }

  .prose :global(ul) { list-style: none; padding-left: 0; }

  .prose :global(ul li) {
    position: relative;
    padding-left: 26px;
    margin-bottom: 10px;
  }

  .prose :global(ul li)::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.72em;
    width: 7px;
    height: 1px;
    background: var(--blood);
  }

  .prose :global(ol) { list-style: decimal; }
  .prose :global(ol li) { margin-bottom: 10px; padding-left: 6px; }
  .prose :global(ol li::marker) { font-family: var(--mono); font-size: 0.82em; color: var(--brass); }

  .prose :global(strong) { color: var(--bone); font-weight: 600; }
  .prose :global(em) { color: var(--ash); }

  .prose :global(a) {
    color: var(--blood-hi);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--blood);
    transition: color 200ms, text-decoration-color 200ms;
  }

  .prose :global(a:hover) { color: var(--brass); text-decoration-color: var(--brass-dim); }

  .prose :global(blockquote) {
    border-left: 1px solid var(--blood);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
    font-style: italic;
    font-size: 1.15em;
    color: var(--ash);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--soot-2);
    border: 1px solid var(--line);
    padding: 2px 7px;
    color: var(--brass);
  }

  .prose :global(pre) {
    background: var(--soot);
    border: 1px solid var(--line);
    padding: 22px;
    overflow-x: auto;
    margin-bottom: 28px;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: var(--bone);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 52px 0;
  }

  .prose :global(img) { border: 1px solid var(--line); margin-bottom: 26px; }

  /* ════ END ════════════════════════════════════════════════ */
  .post-end {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: clamp(52px, 8vw, 84px);
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(36px, 5vw, 56px);
  }

  .adj {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border: 1px solid var(--line);
    transition: border-color 260ms, transform 260ms var(--ease);
  }

  .adj:hover { border-color: var(--blood); transform: translateY(-2px); }

  .adj-next { text-align: right; }

  .adj-label {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass-dim);
  }

  .adj-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--bone);
  }

  @media (max-width: 620px) {
    .adjacent { grid-template-columns: 1fr; }
    .adj-next { text-align: left; }
  }
</style>
