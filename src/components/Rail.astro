---
// The spine — a fixed binding edge down the left of the volume.
// Carries the sigil, the running head of the current page, and a
// blood line that fills as you descend.
import Brand from "./Brand.astro";

const { pathname } = Astro.url;

const running =
  pathname.startsWith("/projects") ? "The Armoury" :
  pathname.startsWith("/blog")     ? "The Chronicles" :
  pathname.startsWith("/contact")  ? "Send Word" :
  "The Struggler";
---

<aside class="rail" aria-hidden="true">
  <a href="/" class="rail-sigil" tabindex="-1">
    <Brand size={22} />
  </a>

  <span class="rail-running">{running}</span>

  <div class="rail-track">
    <span class="rail-fill" id="rail-fill"></span>
  </div>

  <span class="rail-foot">HK</span>
</aside>

<style>
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--rail-w);
    z-index: 90;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0 20px;
    border-right: 1px solid var(--line);
    background: var(--void);
    transition: background-color 700ms var(--ease), border-color 700ms var(--ease);
  }

  @media (min-width: 1080px) {
    .rail { display: flex; }
  }

  .rail-sigil {
    display: block;
    opacity: 0.85;
    transition: opacity 200ms, transform 300ms var(--ease);
  }

  .rail-sigil:hover { opacity: 1; transform: translateY(-2px); }

  .rail-running {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ash-dim);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .rail-track {
    position: absolute;
    right: -1px;
    top: 0;
    width: 1px;
    height: 100%;
    overflow: hidden;
  }

  .rail-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, var(--brass), var(--blood) 45%, var(--blood-hi));
    transform: scaleY(var(--p, 0));
    transform-origin: top center;
  }

  .rail-foot {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    color: var(--ash-dim);
  }
</style>
