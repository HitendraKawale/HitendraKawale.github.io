---
// The Behelit — the egg of the king. Press it and the Eclipse begins.
// Toggles the site's second palette; the choice is remembered.
---

<button
  class="behelit"
  id="behelit"
  type="button"
  aria-pressed="false"
  aria-label="Trigger the Eclipse"
  title="The Behelit"
>
  <svg viewBox="0 0 34 42" width="19" height="24" aria-hidden="true">
    <!-- the egg -->
    <ellipse cx="17" cy="23" rx="15" ry="18" class="shell" />
    <!-- the scattered features -->
    <ellipse cx="11" cy="15" rx="2.6" ry="2" class="feature" />
    <ellipse cx="23.5" cy="19" rx="2.2" ry="1.7" class="feature" />
    <path d="M9 28 q5 4 11 1" class="feature-line" />
    <path d="M20 10 q3 1 3.5 3.5" class="feature-line" />
    <ellipse cx="14" cy="33" rx="1.5" ry="2.4" class="feature" />
  </svg>
  <span class="behelit-label">Eclipse</span>
</button>

<style>
  .behelit {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 12px 7px 10px;
    border: 1px solid var(--line);
    color: var(--ash);
    transition: border-color 260ms, color 260ms, background-color 260ms;
  }

  .behelit:hover {
    border-color: var(--brass-dim);
    color: var(--brass);
    background: rgba(200, 162, 74, 0.05);
  }

  .behelit svg { overflow: visible; }

  .shell {
    fill: var(--soot-2);
    stroke: currentColor;
    stroke-width: 1.4;
    transition: fill 400ms, stroke 400ms;
  }

  .feature { fill: currentColor; }

  .feature-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .behelit-label {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* Once sacrificed, the egg weeps and the features align */
  :global(:root[data-eclipse]) .behelit {
    border-color: var(--blood);
    color: var(--blood-hi);
    background: rgba(194, 24, 28, 0.1);
  }

  :global(:root[data-eclipse]) .shell {
    fill: #2b0a0c;
    animation: weep 3.4s ease-in-out infinite;
  }

  @keyframes weep {
    0%, 100% { filter: drop-shadow(0 0 2px rgba(255, 75, 46, 0.5)); }
    50%      { filter: drop-shadow(0 0 8px rgba(255, 75, 46, 0.95)); }
  }

  @media (max-width: 900px) {
    .behelit-label { display: none; }
    .behelit { padding: 7px 9px; }
  }
</style>
