---
// The Arsenal — two engraved bands running against each other.
// The lower band is outlined, as if the plate were struck twice.
interface Props {
  items: string[];
  speed?: number;
}

const { items, speed = 52 } = Astro.props;
const run = [...items, ...items];
---

<section class="arsenal bleed" aria-label="Arsenal">
  <div class="arsenal-head wrap">
    <span class="label label-brass">[ Arsenal ]</span>
    <span class="arsenal-count">{items.length} instruments</span>
  </div>

  <div class="band" style={`--speed:${speed}s`}>
    <div class="track">
      {run.map(item => (
        <span class="item">
          {item}
          <span class="sep" aria-hidden="true">✦</span>
        </span>
      ))}
    </div>
  </div>

  <div class="band band-ghost" style={`--speed:${speed * 1.3}s`}>
    <div class="track track-rev">
      {run.map(item => (
        <span class="item">
          {item}
          <span class="sep" aria-hidden="true">✦</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .arsenal {
    padding-block: clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .arsenal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 26px;
  }

  .arsenal-count {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ash-dim);
  }

  .band {
    display: flex;
    width: max-content;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .band-ghost { margin-top: 4px; }

  .track {
    display: flex;
    align-items: center;
    animation: slide var(--speed) linear infinite;
  }

  .track-rev { animation-direction: reverse; }

  .arsenal:hover .track { animation-play-state: paused; }

  @keyframes slide {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
    padding-right: clamp(16px, 2.4vw, 34px);
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 4.4vw, 3.1rem);
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--bone);
  }

  .band-ghost .item {
    color: transparent;
    -webkit-text-stroke: 1px var(--ash-dim);
    font-weight: 400;
  }

  .sep {
    font-size: 0.36em;
    color: var(--blood-hi);
    transform: translateY(-0.28em);
  }

  .band-ghost .sep {
    color: var(--brass-dim);
    -webkit-text-stroke: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .band { -webkit-mask-image: none; mask-image: none; overflow-x: auto; width: 100%; }
    .track { animation: none; }
  }
</style>
