---
// Ambient ash — motes drifting up through the volume.
// Painted by the site script; hidden entirely for reduced motion.
---

<canvas id="ash" class="ash" aria-hidden="true"></canvas>

<style>
  .ash {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .ash { display: none; }
  }
</style>
