---
// The index of deeds — set like a volume's table of contents.
// Hovering a line summons the panel it refers to.
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="ix" data-index>
  {projects.map((p, i) => {
    const Tag = p.href ? "a" : "div";
    return (
      <Tag
        class="ix-row"
        data-row
        data-title={p.title}
        data-subtitle={p.subtitle}
        data-status={p.status}
        data-stack={p.stack.join("|")}
        href={p.href}
        target={p.href ? "_blank" : undefined}
        rel={p.href ? "noreferrer" : undefined}
        data-reveal="rise"
        style={`--d:${i * 70}ms`}
      >
        <span class="ix-num">{String(i + 1).padStart(2, "0")}</span>

        <span class="ix-main">
          <span class="ix-title">{p.title}</span>
          <span class="ix-sub">{p.subtitle}</span>
        </span>

        <span class="ix-meta">
          <span class:list={["ix-status", p.status.toLowerCase().replace(" ", "-")]}>{p.status}</span>
          <span class="ix-arrow" aria-hidden="true">{p.href ? "↗" : "—"}</span>
        </span>
      </Tag>
    );
  })}
</div>

<!-- The summoned panel -->
<div class="ip" data-index-panel aria-hidden="true">
  <div class="ip-cap tone">
    <span class="ip-plate" data-field="title"></span>
  </div>
  <div class="ip-body">
    <span class="ip-label">Built with</span>
    <div class="ip-stack" data-stack></div>
  </div>
</div>

<style>
  .ix { border-top: 1px solid var(--line); }

  .ix-row {
    display: grid;
    grid-template-columns: 54px 1fr auto;
    align-items: center;
    gap: clamp(12px, 3vw, 32px);
    padding: clamp(18px, 2.4vw, 26px) 0;
    border-bottom: 1px solid var(--line);
    position: relative;
    isolation: isolate;
  }

  /* Blood floods the row from the left */
  .ix-row::before {
    content: '';
    position: absolute;
    inset: 0 0 0 -100vw;
    z-index: -1;
    background: linear-gradient(90deg, transparent, rgba(147, 23, 27, 0.14) 78%, rgba(147, 23, 27, 0.26));
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }

  .ix-row:hover::before { opacity: 1; }

  .ix-num {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--brass-dim);
    font-variant-numeric: tabular-nums;
    transition: color 300ms;
  }

  .ix-row:hover .ix-num { color: var(--brass); }

  .ix-main { min-width: 0; }

  .ix-title {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3.6vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--bone);
    transition: color 300ms var(--ease), transform 460ms var(--ease);
  }

  .ix-row:hover .ix-title {
    color: var(--blood-hi);
    transform: translateX(10px);
  }

  .ix-sub {
    display: block;
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.02em;
    color: var(--ash-dim);
    margin-top: 10px;
    transition: color 300ms, transform 460ms var(--ease);
  }

  .ix-row:hover .ix-sub { color: var(--ash); transform: translateX(10px); }

  .ix-meta {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 20px);
  }

  .ix-status {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ash-dim);
    white-space: nowrap;
  }

  .ix-status.built       { color: var(--ash); }
  .ix-status.research    { color: var(--brass-dim); }
  .ix-status.in-progress { color: var(--brass); }

  .ix-arrow {
    font-size: 1rem;
    color: var(--ash-dim);
    transition: transform 320ms var(--ease), color 300ms;
  }

  .ix-row:hover .ix-arrow { color: var(--blood-hi); transform: translate(3px, -3px); }

  /* ── The summoned panel ─────────────────────────── */
  .ip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: 320px;
    pointer-events: none;
    background: var(--soot);
    border: 1px solid var(--line);
    box-shadow: 10px 10px 0 0 rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity 260ms var(--ease);
    display: none;
  }

  .ip.on { opacity: 1; }

  .ip-cap {
    display: flex;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
  }

  .ip-plate {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .ip-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ip-label {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ash-dim);
  }

  .ip-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .ip-stack :global(.ip-chip) {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border: 1px solid var(--line);
    color: var(--ash);
    background: var(--soot-2);
  }

  @media (hover: hover) and (min-width: 900px) {
    .ip { display: block; }
  }

  @media (max-width: 899px) {
    .ix-row { grid-template-columns: 36px 1fr auto; align-items: start; }
    .ix-num { padding-top: 6px; }
    .ix-meta { flex-direction: column; align-items: flex-end; gap: 8px; padding-top: 6px; }
  }
</style>
