---
import Brand from "./Brand.astro";
import Behelit from "./Behelit.astro";

const { pathname } = Astro.url;

const links = [
  { href: "/projects", label: "Armoury",   match: "/projects" },
  { href: "/blog",     label: "Chronicles", match: "/blog" },
  { href: "/contact",  label: "Send Word",  match: "/contact" },
];
---

<header class="nav-wrap">
  <nav class="nav wrap" aria-label="Primary">
    <a href="/" class="brand" aria-label="Home — The Struggler">
      <Brand size={24} />
      <span class="brand-han">泽贤</span>
      <span class="brand-name">Hitendra Kawale</span>
    </a>

    <div class="nav-right">
      <ul class="nav-links">
        {links.map(l => (
          <li>
            <a
              href={l.href}
              class:list={["nl", { active: pathname.startsWith(l.match) }]}
            >
              <span class="nl-bracket">[</span>{l.label}<span class="nl-bracket">]</span>
            </a>
          </li>
        ))}
      </ul>

      <Behelit />

      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </nav>
</header>

<!-- Full-screen menu, small viewports -->
<div class="menu" id="menu" hidden>
  <div class="menu-inner wrap">
    <span class="label label-ash menu-eyebrow">[ Navigation ]</span>
    <ul>
      {links.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={l.href} class="menu-link">
            <span class="menu-num">0{i + 1}</span>{l.label}
          </a>
        </li>
      ))}
      <li style="--i:3">
        <a href="/" class="menu-link"><span class="menu-num">00</span>Home</a>
      </li>
    </ul>
  </div>
</div>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--void) 92%, transparent);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border-bottom: 1px solid var(--line);
    transition: background-color 700ms var(--ease), border-color 700ms var(--ease);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: var(--nav-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }

  .brand :global(.brand-mark) { transition: transform 400ms var(--ease), filter 300ms; }
  .brand:hover :global(.brand-mark) {
    transform: rotate(-8deg) scale(1.06);
    filter: drop-shadow(0 0 9px rgba(207, 53, 32, 0.85));
  }

  .brand-han {
    font-family: var(--han);
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.06em;
    transition: color 200ms;
  }

  .brand:hover .brand-han { color: var(--blood-hi); }

  .brand-name {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ash-dim);
    padding-left: 11px;
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 26px);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 24px);
  }

  .nl {
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ash);
    transition: color 200ms;
    white-space: nowrap;
  }

  .nl-bracket {
    color: var(--ash-dim);
    transition: color 200ms, opacity 200ms;
    opacity: 0.55;
  }

  .nl:hover, .nl.active { color: var(--bone); }
  .nl:hover .nl-bracket { color: var(--brass); opacity: 1; }
  .nl.active .nl-bracket { color: var(--blood-hi); opacity: 1; }

  /* ── Burger ─────────────────────────── */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    align-items: flex-end;
  }

  .burger span {
    display: block;
    height: 1px;
    background: var(--bone);
    transition: transform 320ms var(--ease), width 320ms var(--ease);
  }

  .burger span:nth-child(1) { width: 22px; }
  .burger span:nth-child(2) { width: 14px; }
  .burger:hover span:nth-child(2) { width: 22px; }

  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(3px) rotate(45deg); width: 22px; }
  .burger[aria-expanded="true"] span:nth-child(2) { transform: translateY(-3px) rotate(-45deg); width: 22px; }

  @media (max-width: 780px) {
    .nav-links { display: none; }
    .burger { display: flex; }
    .brand-name { display: none; }
  }

  @media (max-width: 420px) {
    .brand-han { font-size: 1rem; }
  }

  /* ── Full-screen menu ───────────────── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: var(--void);
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }

  .menu[hidden] { display: none; }
  .menu.open { opacity: 1; }

  .menu-inner { width: 100%; }

  .menu-eyebrow { display: block; margin-bottom: 30px; }

  .menu li {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .menu-link {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 18px 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2rem, 11vw, 3.4rem);
    letter-spacing: -0.02em;
    transform: translateY(105%);
    transition: transform 520ms var(--ease), color 200ms;
    transition-delay: calc(var(--i) * 60ms);
  }

  .menu.open .menu-link { transform: translateY(0); }
  .menu-link:hover { color: var(--blood-hi); }

  .menu-num {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--brass);
  }
</style>
